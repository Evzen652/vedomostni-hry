{
  "name": "vedomostni-hry-kviz",
  "version": "1.0.0",
  "private": true,
  "description": "Vědomostní kvízová hra (zeměpis) — otázky, fondy, export balíčků",
  "scripts": {
    "validate": "node scripts/validate-data.js",
    "audit": "node scripts/audit-questions.js",
    "test:offline": "node scripts/test-offline.js",
    "test:ghost": "node scripts/test-ghost.js",
    "test:expire": "node scripts/test-expire.js",
    "test:duel": "node scripts/test-duel.js",
    "lint-irony": "node scripts/lint-irony-prompts.js",
    "gen-facts": "node scripts/gen-more-facts.js",
    "lint-facts": "node scripts/lint-more-facts.js",
    "gen-irony": "node scripts/gen-irony-images.js",
    "sim-online": "node scripts/sim-online.js",
    "dev": "wrangler pages dev .",
    "db:seed": "node scripts/seed-d1.js",
    "db:init": "npm run db:seed && wrangler d1 execute zemekviz --local --file=schema.sql && wrangler d1 execute zemekviz --local --file=data/d1-seed.sql",
    "db:sql": "wrangler d1 execute zemekviz --local --command",
    "import-questions": "node scripts/import-questions.js",
    "import-images": "node scripts/import-images.js",
    "import-audio": "node scripts/import-audio.js",
    "export-deck": "node scripts/export-deck.js",
    "test:api": "node scripts/test-api.js",
    "db:init:remote": "npm run db:seed && wrangler d1 execute zemekviz --remote --file=schema.sql && wrangler d1 execute zemekviz --remote --file=data/d1-seed.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name zemekviz",
    "build": "node scripts/build-public.js",
    "db:sync": "node scripts/sync-d1-questions.js"
  },
  "devDependencies": {
    "sharp": "^0.35.2",
    "wrangler": "^4.125.0"
  }
}
